// OpenTitan AES simulation filelist
// Usage (example):
//   vlog -f aes_rtl.filelist   or   vcs -f aes_rtl.filelist   or   xrun -f aes_rtl.filelist
// Top: rtl/aes.sv (module: aes)

// ------------------------
// Include directories
// ------------------------
+incdir+rtl
+incdir+../prim/rtl
+incdir+../tlul/rtl
+incdir+../lc_ctrl/rtl
+incdir+../edn/rtl
+incdir+../keymgr/rtl
+incdir+../entropy_src/rtl
+incdir+../csrng/rtl

// ------------------------
// Defines (minimal for sim)
// ------------------------
// Keep assertions and initial blocks out to satisfy strict parsers
+define+SYNTHESIS
// If you want assertion macros, comment the above and optionally define INC_ASSERT here.
// +define+INC_ASSERT

// ------------------------
// Packages (order matters)
// ------------------------
// Top-level width/package parameters needed by TL-UL
../../top_earlgrey/rtl/top_pkg.sv
// SECDED package used by TL-UL integrity helpers
../prim/rtl/prim_secded_pkg.sv
../prim/rtl/prim_util_pkg.sv
../prim/rtl/prim_mubi_pkg.sv
../prim/rtl/prim_alert_pkg.sv
../tlul/rtl/tlul_pkg.sv

// Life-cycle and related packages
../lc_ctrl/rtl/lc_ctrl_state_pkg.sv
../lc_ctrl/rtl/lc_ctrl_reg_pkg.sv
../lc_ctrl/rtl/lc_ctrl_pkg.sv

// Entropy + CSRNG packages used by edn_pkg
../entropy_src/rtl/entropy_src_pkg.sv
../csrng/rtl/csrng_pkg.sv
../edn/rtl/edn_pkg.sv

// Key manager packages
../keymgr/rtl/keymgr_reg_pkg.sv
../keymgr/rtl/keymgr_pkg.sv

// AES packages
rtl/aes_reg_pkg.sv
rtl/aes_pkg.sv

// ------------------------
// Primaries required by AES
// ------------------------
// Assertions (provides assertion macro implementations)
../prim/rtl/prim_assert.sv
// Sparse FSM hardened flop used by AES FSMs
../prim/rtl/prim_sparse_fsm_flop.sv

// Sync utilities
../prim/rtl/prim_sync_reqack_data.sv
../prim/rtl/prim_lc_sync.sv
../prim/rtl/prim_sync_reqack.sv

// Subregister and register utilities (used by aes_reg_top)
../prim/rtl/prim_subreg_pkg.sv
../prim/rtl/prim_subreg.sv
../prim/rtl/prim_subreg_ext.sv
../prim/rtl/prim_subreg_shadow.sv
../prim/rtl/prim_reg_we_check.sv
../prim/rtl/prim_subreg_arb.sv
../prim/rtl/prim_onehot_check.sv

// TL-UL components used by register block
../tlul/rtl/tlul_adapter_reg.sv
../tlul/rtl/tlul_cmd_intg_chk.sv
../tlul/rtl/tlul_rsp_intg_gen.sv
../tlul/rtl/tlul_err.sv
../tlul/rtl/tlul_data_integ_dec.sv
../tlul/rtl/tlul_data_integ_enc.sv

// Alert infrastructure used by AES top
../prim/rtl/prim_diff_decode.sv
../prim/rtl/prim_sec_anchor_buf.sv
../prim/rtl/prim_sec_anchor_flop.sv
../prim/rtl/prim_alert_receiver.sv
../prim/rtl/prim_alert_sender.sv

// PRNG helpers used by AES PRNG blocks
../prim/rtl/prim_cipher_pkg.sv
../prim/rtl/prim_trivium_pkg.sv
rtl/prim_dummy_trivium.sv
../prim/rtl/prim_packer.sv
../prim/rtl/prim_packer_fifo.sv
../prim/rtl/prim_lfsr.sv
../prim/rtl/prim_cdc_rand_delay.sv
// Prim SECDED modules used by TLUL integrity helpers
../prim/rtl/prim_secded_inv_64_57_dec.sv
../prim/rtl/prim_secded_inv_39_32_dec.sv
../prim/rtl/prim_secded_inv_64_57_enc.sv
../prim/rtl/prim_secded_inv_39_32_enc.sv

// Generic primitive implementations and wrappers
../prim_generic/rtl/prim_generic_buf.sv
../prim_generic/rtl/prim_generic_flop.sv
../prim_generic/rtl/prim_generic_flop_2sync.sv
../prim_generic/rtl/prim_generic_flop_en.sv
../../vendor/lowrisc_ibex/dv/uvm/core_ibex/common/prim/prim_buf.sv
../../vendor/lowrisc_ibex/dv/uvm/core_ibex/common/prim/prim_flop.sv
rtl/prim_compat_wrappers.sv

// ------------------------
// AES RTL (top last in this group, before wrap)
// ------------------------
rtl/aes_ctrl_reg_shadowed.sv
rtl/aes_reg_status.sv
rtl/aes_cipher_control_fsm_n.sv
rtl/aes_cipher_control_fsm_p.sv
rtl/aes_cipher_control_fsm.sv
rtl/aes_cipher_control.sv
rtl/aes_control_fsm_p.sv
rtl/aes_control_fsm_n.sv
rtl/aes_control_fsm.sv
rtl/aes_control.sv
rtl/aes_cipher_core.sv
rtl/aes_ctr_fsm_n.sv
rtl/aes_ctr_fsm_p.sv
rtl/aes_ctr_fsm.sv
